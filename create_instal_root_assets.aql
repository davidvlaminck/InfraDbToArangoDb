LET rootNames = (
    FOR a IN assets
        FILTER HAS(a, "naampad_parts") AND LENGTH(a.naampad_parts) > 0
        RETURN a.naampad_parts[0]
)

LET uniqueRootNames = UNIQUE(rootNames)

LET activeParents = (
    FOR a IN assets
        FILTER a.AIMDBStatus_isActief == true
           AND HAS(a, "naampad_parent")
        RETURN a.naampad_parent
)

LET rootsWithActiveChild = UNIQUE(activeParents)

FOR rootName IN uniqueRootNames
    LET assetKey = CONCAT("instal_", SUBSTITUTE(rootName, "/", "_"))
    LET isActief = rootName IN rootsWithActiveChild
    UPSERT { _key: assetKey }
    INSERT {
        _key: assetKey,
        AIMObject_typeURI: "https://lgc.data.wegenenverkeer.be/ns/installatie#Instal",
        "@type": "https://lgc.data.wegenenverkeer.be/ns/installatie#Instal",
        NaampadObject_naampad: rootName,
        naampad_parts: [rootName],
        AIMDBStatus_isActief: isActief
    }
    UPDATE { AIMDBStatus_isActief: isActief } IN assets
    OPTIONS { ignoreErrors: true }

RETURN COUNT(uniqueRootNames)